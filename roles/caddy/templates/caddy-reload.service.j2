[Unit]
Description=Validate and reload Caddy
After={{ caddy_service_name }}.service
Requires={{ caddy_service_name }}.service

[Service]
Type=oneshot
Environment=HOME=/var/lib/caddy
Environment=XDG_CONFIG_HOME=/var/lib/caddy/.config
ExecStart=/bin/sh -c '/usr/bin/caddy validate --config {{ caddy_config_file }} --adapter caddyfile && /usr/bin/systemctl reload {{ caddy_service_name }}'
