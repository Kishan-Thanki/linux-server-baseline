#!/usr/bin/env bash
# ==============================================================================
# {{ deployproxy_cli_path }}
# Dedicated Proxy Artifact Deployment CLI
# ==============================================================================
# Ansible managed: Do NOT edit manually on host.
#
# This deploy script is backend-agnostic and can validate downloaded proxy
# configs using a runtime-specific command such as:
#   - caddy validate --config %s --adapter caddyfile
#   - nginx -t -c %s
#
# Use --validator-check to confirm the proxy backend is installed first, and
#     --validator-command to run the actual validation step before deployment.

set -euo pipefail

show_usage() {
  cat <<EOF
    Usage: ${deployproxy_command} --name <app_name> --type raw --artifact <https://.../proxy.tar.gz> [options]

    Required options:
      --name <app_name>            Application name, e.g. resumeranker
      --type raw                   Proxy artifact type. Currently supported value: raw
      --artifact <source>          HTTP(S) URL to the proxy artifact, e.g. https://github.com/org/repo/releases/download/proxy-v1.2.3/proxy.tar.gz
      --proxy-ext <ext>            Config extension to write, e.g. caddyfile, conf

    Optional options:
      --validator-check <cmd>      Runtime presence check, e.g. "command -v caddy" or "command -v nginx"
      --validator-command <cmd>    Validation command using %s as the downloaded temp file, e.g. "caddy validate --config %s --adapter caddyfile"

    Example (Caddy):
      ${deployproxy_command} \
        --name webapp \
        --type raw \
        --artifact "https://github.com/org/repo/releases/download/proxy-v1.2.3/proxy.tar.gz" \
        --proxy-ext caddyfile \
        --validator-check "command -v caddy" \
        --validator-command "caddy validate --config %s --adapter caddyfile"

    Example (Nginx):
      ${deployproxy_command} \
        --name webapp \
        --type raw \
        --artifact "https://github.com/org/repo/releases/download/proxy-v1.2.3/proxy.tar.gz" \
        --proxy-ext conf \
        --validator-check "command -v nginx" \
        --validator-command "nginx -t -c %s"
  EOF
}

usage() {
  show_usage
  exit 1
}

usage_exit0() {
  show_usage
  exit 0
}

log_info()  { echo "[INFO]  $(date +'%Y-%m-%d %H:%M:%S') - $*"; }
log_error() { echo "[ERROR] $(date +'%Y-%m-%d %H:%M:%S') - $*" >&2; }

require_value() {
  local arg_name="$1"
  local value="${2:-}"

  if [[ -z "${value}" ]]; then
    log_error "Missing value for ${arg_name}."
    usage
  fi
}

app_name=""
type=""
artifact=""
proxy_ext=""
validator_check=""
validator_command=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help) usage_exit0 ;;
    --name)
      require_value "--name" "${2:-}"
      app_name="$2"
      shift 2
      ;;
    --type)
      require_value "--type" "${2:-}"
      type="$2"
      shift 2
      ;;
    --artifact)
      require_value "--artifact" "${2:-}"
      artifact="$2"
      shift 2
      ;;
    --proxy-ext)
      require_value "--proxy-ext" "${2:-}"
      proxy_ext="$2"
      shift 2
      ;;
    --validator-check)
      require_value "--validator-check" "${2:-}"
      validator_check="$2"
      shift 2
      ;;
    --validator-command)
      require_value "--validator-command" "${2:-}"
      validator_command="$2"
      shift 2
      ;;
    *)
      echo "Unknown option: $1"
      usage
      ;;
  esac
done

if [ -z "${app_name}" ] || [ -z "${type}" ] || [ -z "${artifact}" ] || [ -z "${proxy_ext}" ]; then
  log_error "--name, --type, --artifact and --proxy-ext are required."
  usage
fi

case "${type}" in
  raw)
    if [[ "${artifact}" != http://* && "${artifact}" != https://* ]]; then
      log_error "Raw proxy artifacts must use an HTTP(S) URL via --artifact."
      exit 1
    fi
    ;;
  image)
    log_error "Proxy image artifacts are not supported by this generic proxy deployment CLI yet."
    exit 1
    ;;
  *)
    log_error "Unsupported proxy type '${type}'. Use raw or image."
    exit 1
    ;;
esac

target_file="${deployproxy_dropin_dir}/${app_name}.${proxy_ext}"
temp_file=$(mktemp /tmp/proxy.XXXXXX)

log_info "Downloading proxy config artifact for '${app_name}'..."
if ! curl -fsSL "${artifact}" -o "${temp_file}"; then
  log_error "Failed to download proxy config from ${artifact}"
  rm -f "${temp_file}"
  exit 1
fi

if [ -n "${validator_check}" ]; then
  log_info "Checking whether the proxy backend is available..."
  if ! bash -lc "${validator_check}" >/dev/null 2>&1; then
    log_error "Proxy validation dependency check failed: ${validator_check}"
    rm -f "${temp_file}"
    exit 1
  fi
fi

if [ -n "${validator_command}" ]; then
  log_info "Validating proxy config syntax..."
  validator_cmd="${validator_command//%s/${temp_file}}"
  if ! bash -lc "${validator_cmd}" >/dev/null 2>&1; then
    log_error "Downloaded proxy config contains syntax errors! Deployment aborted."
    rm -f "${temp_file}"
    exit 1
  fi
fi

log_info "Deploying drop-in configuration to ${target_file}..."
mv "${temp_file}" "${target_file}"
chmod 0664 "${target_file}"

log_info "Proxy deployment completed successfully for '${app_name}'."
