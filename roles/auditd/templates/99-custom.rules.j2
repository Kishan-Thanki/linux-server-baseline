# Managed by Ansible (role: auditd). Do not edit by hand.
# -w = watch a path, -p wa = log writes and attribute changes, -k = search key.
# Look events up with: sudo ausearch -k <key>

# Identity and authentication files
-w /etc/group -p wa -k identity
-w /etc/passwd -p wa -k identity
-w /etc/gshadow -p wa -k identity
-w /etc/shadow -p wa -k identity
-w /etc/security/opasswd -p wa -k identity

# Sudo and privilege escalation configuration
-w /etc/sudoers -p wa -k scope
-w /etc/sudoers.d/ -p wa -k scope

# SSH configuration
-w /etc/ssh/sshd_config -p wa -k sshd_config
-w /etc/ssh/sshd_config.d/ -p wa -k sshd_config

# Network and login banner files
-w /etc/issue -p wa -k system-locale
-w /etc/issue.net -p wa -k system-locale
-w /etc/hosts -p wa -k system-locale

# systemd unit overrides (includes the firewalld boot-cycle override)
-w /etc/systemd/system/ -p wa -k systemd_units

# Firewall and intrusion-prevention configuration
-w /etc/firewalld/ -p wa -k firewall
-w /etc/fail2ban/ -p wa -k fail2ban

# Successful logins
-w /var/log/lastlog -p wa -k logins

# Audit configuration itself
-w /etc/audit/ -p wa -k auditconfig
