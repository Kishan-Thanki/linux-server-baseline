#!/usr/bin/env bash
# ==============================================================================
# {{ release_engine_cli_path }}
# Universal Dynamic Application Deployment CLI Engine
# ==============================================================================
# Ansible managed: Do NOT edit manually on host.

set -euo pipefail

APPS_ROOT="{{ release_engine_apps_root }}"

usage() {
  cat <<EOF
    Usage: deploy <command> [options]

    Commands:
      deploy    Deploy a release (raw archive or container image)
      rollback  Rollback an application to a previous healthy release
      status    Show active release status and deployment history
      releases  List all stored releases for an application

    Deploy Options:
      --name <app_name>           (Required) Application name
      --type <raw|image>          (Required) Artifact type: raw archive or OCI/Docker image
      --artifact <source>         (Required) Artifact source: HTTP(S) archive URL or container image reference
      --auth-header <header>      Custom HTTP header for downloads (e.g., "Authorization: Bearer <token>")
      --auth-user <user:pass>     Basic/Digest HTTP auth
      --registry-auth <user:pass> Image registry auth
      --post-deploy <command>     Hook command to run after extraction (e.g., venv setup, npm install)
      --health <check>            Repeatable health check. Supported values:
                                  http://host/path
                                  https://host/path
                                  tcp://host:port
                                  exec:"/path/script.sh" or "curl -fsS http://host/health"
      --keep-releases <num>       Number of old releases to retain
      --force                     Force redeploy even if the artifact hash matches the current release

    Rollback Options:
      --name <app_name>           (Required) Application name
      --steps <num>               Number of releases to rollback (default: 1)

  EOF
  exit 1
}

log_info()  { echo "[INFO]  $(date +'%Y-%m-%d %H:%M:%S') - $*"; }
log_error() { echo "[ERROR] $(date +'%Y-%m-%d %H:%M:%S') - $*" >&2; }
log_warn()  { echo "[WARN]  $(date +'%Y-%m-%d %H:%M:%S') - $*"; }

ensure_app_structure() {
  local app_name="$1"
  local app_dir="${APPS_ROOT}/${app_name}"
  mkdir -p "${app_dir}/releases"
  mkdir -p "${app_dir}/staging"
  mkdir -p "${app_dir}/shared/logs"
  mkdir -p "${app_dir}/shared/data"
  mkdir -p "${app_dir}/shared/runtime"
  mkdir -p "${app_dir}/shared/env.d"
  mkdir -p "${app_dir}/systemd"

  if [ ! -f "${app_dir}/shared/.env" ]; then
    touch "${app_dir}/shared/.env"
  fi

  if [ ! -f "${app_dir}/deploy.json" ]; then
    echo '{"active_release":"","history":[]}' > "${app_dir}/deploy.json"
  fi
}

run_health_check() {
  local app_name="$1"
  shift 1
  local checks=("$@")

  log_info "Running health checks..."

  for check in "${checks[@]}"; do
    case "${check}" in
      http://*|https://*)
        log_info "Polling HTTP endpoint: ${check}..."
        local retries=20
        local success=0
        for ((i=1; i<=retries; i++)); do
          local code
          code=$(curl -s -o /dev/null -w "%{http_code}" "${check}" || echo "000")
          if [[ "${code}" =~ ^2[0-9]{2}$ ]]; then
            log_info "HTTP health check passed (HTTP ${code})."
            success=1
            break
          fi
          sleep 2
        done
        if [ "${success}" -eq 0 ]; then
          log_error "HTTP health check failed after ${retries} attempts: ${check}"
          return 1
        fi
        ;;

      tcp://*)
        local tcp_target="${check#tcp://}"
        log_info "Polling TCP socket: ${tcp_target}..."
        local host="${tcp_target%%:*}"
        local port="${tcp_target##*:}"
        local retries=20
        local success=0
        for ((i=1; i<=retries; i++)); do
          if nc -z -w 2 "${host}" "${port}" 2>/dev/null; then
            log_info "TCP health check passed for ${tcp_target}."
            success=1
            break
          fi
          sleep 2
        done
        if [ "${success}" -eq 0 ]; then
          log_error "TCP socket health check failed for ${tcp_target}."
          return 1
        fi
        ;;

      exec:*)
        local health_exec="${check#exec:}"
        log_info "Executing custom health check command: ${health_exec}..."
        if ! eval "${health_exec}"; then
          log_error "Custom health check command failed: ${health_exec}"
          return 1
        fi
        ;;

      *)
        log_error "Unsupported health check '${check}'. Use http://..., https://..., tcp://..., or exec:..."
        return 1
        ;;
    esac
  done

  log_info "All health checks passed successfully."
  return 0
}

cmd_deploy() {
  local app_name=""
  local type=""
  local artifact=""
  local auth_header=""
  local auth_user=""
  local registry_auth=""
  local post_deploy=""
  local health_checks=()
  local keep_releases="1"
  local force=0

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --name) app_name="$2"; shift 2 ;;
      --type) type="$2"; shift 2 ;;
      --artifact) artifact="$2"; shift 2 ;;
      --auth-header) auth_header="$2"; shift 2 ;;
      --auth-user) auth_user="$2"; shift 2 ;;
      --registry-auth) registry_auth="$2"; shift 2 ;;
      --post-deploy) post_deploy="$2"; shift 2 ;;
      --health) health_checks+=("$2"); shift 2 ;;
      --keep-releases) keep_releases="$2"; shift 2 ;;
      --force) force=1; shift 1 ;;
      *) log_error "Unknown option: $1"; usage ;;
    esac
  done

  if [ -z "${app_name}" ] || [ -z "${type}" ] || [ -z "${artifact}" ]; then
    log_error "--name, --type and --artifact are required."
    usage
  fi

  local app_dir="${APPS_ROOT}/${app_name}"
  ensure_app_structure "${app_name}"

  local release_id
  release_id=$(date +'%Y%m%d%H%M%S')
  local target_release_dir="${app_dir}/releases/${release_id}"
  local staging_dir="${app_dir}/staging/${release_id}"
  mkdir -p "${staging_dir}"

  log_info "Starting deployment for '${app_name}' (Release: ${release_id}, Type: ${type})..."

  if [ "${type}" = "raw" ]; then
    if [[ "${artifact}" != http://* && "${artifact}" != https://* ]]; then
      log_error "Raw artifacts must use an HTTP(S) URL via --artifact."
      exit 1
    fi

    local curl_opts=("-sSL")
    if [ -n "${auth_header}" ]; then
      curl_opts+=("-H" "${auth_header}")
    fi
    if [ -n "${auth_user}" ]; then
      curl_opts+=("-u" "${auth_user}")
    fi

    local archive_path="${staging_dir}/artifact"
    log_info "Downloading raw artifact from ${artifact}..."
    if ! curl "${curl_opts[@]}" "${artifact}" -o "${archive_path}"; then
      log_error "Download failed."
      rm -rf "${staging_dir}"
      exit 1
    fi

    mkdir -p "${target_release_dir}"
    log_info "Extracting artifact to release directory..."
    if tar -tf "${archive_path}" &>/dev/null; then
      tar -xf "${archive_path}" -C "${target_release_dir}"
    elif unzip -t "${archive_path}" &>/dev/null; then
      unzip -q "${archive_path}" -d "${target_release_dir}"
    else
      mv "${archive_path}" "${target_release_dir}/executable"
      chmod +x "${target_release_dir}/executable"
    fi
    rm -rf "${staging_dir}"

  elif [ "${type}" = "image" ]; then
    if [[ "${artifact}" == http://* || "${artifact}" == https://* ]]; then
      log_error "Image artifacts must be an OCI/Docker image reference, not an HTTP(S) URL."
      exit 1
    fi

    if [ -n "${registry_auth}" ]; then
      local reg_user="${registry_auth%%:*}"
      local rest="${registry_auth#*:}"
      local reg_pass="${rest%%@*}"
      local reg_server="${rest#*@}"
      echo "${reg_pass}" | docker login "${reg_server}" -u "${reg_user}" --password-stdin
    fi

    log_info "Pulling container image ${artifact}..."
    docker pull "${artifact}"
    mkdir -p "${target_release_dir}"
    echo "IMAGE=${artifact}" > "${target_release_dir}/image.env"
    rm -rf "${staging_dir}"
  else
    log_error "Unsupported type '${type}'. Use 'raw' or 'image'."
    exit 1
  fi

  # Link shared items into release dir
  ln -sf "${app_dir}/shared/.env" "${target_release_dir}/.env"
  ln -sf "${app_dir}/shared/data" "${target_release_dir}/data"
  ln -sf "${app_dir}/shared/logs" "${target_release_dir}/logs"

  # Post-deploy hook execution inside release directory
  if [ -n "${post_deploy}" ]; then
    log_info "Running post-deploy hook..."
    (cd "${target_release_dir}" && eval "${post_deploy}")
  fi

  # Save previous release for rollback reference
  local prev_release=""
  if [ -L "${app_dir}/current" ]; then
    prev_release=$(basename "$(readlink "${app_dir}/current")")
  fi

  # Atomic symlink swap
  log_info "Performing atomic symlink swap of ${app_dir}/current -> ${release_id}..."
  ln -sfn "releases/${release_id}" "${app_dir}/current"

  # Health Check Verification
  if ! run_health_check "${app_name}" "${health_checks[@]}"; then
    log_error "Health check failed! Initiating automatic rollback..."
    if [ -n "${prev_release}" ] && [ -d "${app_dir}/releases/${prev_release}" ]; then
      ln -sfn "releases/${prev_release}" "${app_dir}/current"
      log_warn "Rolled back atomically to release ${prev_release}."
    else
      log_error "No previous release found to roll back to!"
    fi
    exit 1
  fi

  # Update deployment metadata
  log_info "Updating deploy.json history..."
  local updated_json
  updated_json=$(jq --arg rel "${release_id}" '.active_release = $rel | .history += [$rel]' "${app_dir}/deploy.json")
  echo "${updated_json}" > "${app_dir}/deploy.json"

  # Prune old releases according to retention policy
  log_info "Applying release retention policy (keeping latest ${keep_releases} releases)..."
  local total_releases
  total_releases=$(ls -1d "${app_dir}/releases/"* 2>/dev/null | sort | head -n -"${keep_releases}" || true)
  for old_rel in ${total_releases}; do
    if [ "$(basename "${old_rel}")" != "${release_id}" ] && [ "$(basename "${old_rel}")" != "${prev_release}" ]; then
      log_info "Pruning old release: $(basename "${old_rel}")"
      rm -rf "${old_rel}"
    fi
  done

  log_info "Deployment completed successfully for ${app_name} (Release: ${release_id})."
}

cmd_rollback() {
  local app_name=""
  local steps=1

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --name) app_name="$2"; shift 2 ;;
      --steps) steps="$2"; shift 2 ;;
      *) log_error "Unknown option: $1"; usage ;;
    esac
  done

  if [ -z "${app_name}" ]; then
    log_error "--name is required for rollback."
    usage
  fi

  local app_dir="${APPS_ROOT}/${app_name}"
  if [ ! -d "${app_dir}" ] || [ ! -L "${app_dir}/current" ]; then
    log_error "Application '${app_name}' does not exist or has no active deployment."
    exit 1
  fi

  local current_rel
  current_rel=$(basename "$(readlink "${app_dir}/current")")
  local all_releases
  all_releases=$(ls -1d "${app_dir}/releases/"* | sort | xargs -n1 basename)

  local rel_array=(${all_releases})
  local total={% raw %}${#rel_array[@]}{% endraw %}
  local curr_index=-1

  for ((i=0; i<total; i++)); do
    if [ "${rel_array[$i]}" = "${current_rel}" ]; then
      curr_index=$i
      break
    fi
  done

  local target_index=$((curr_index - steps))
  if [ ${target_index} -lt 0 ]; then
    log_error "Cannot rollback ${steps} step(s). Not enough historical releases stored."
    exit 1
  fi

  local target_rel="${rel_array[${target_index}]}"
  log_info "Rolling back '${app_name}' from release ${current_rel} -> ${target_rel}..."
  ln -sfn "releases/${target_rel}" "${app_dir}/current"

  local updated_json
  updated_json=$(jq --arg rel "${target_rel}" '.active_release = $rel' "${app_dir}/deploy.json")
  echo "${updated_json}" > "${app_dir}/deploy.json"

  log_info "Rollback successful. '${app_name}' active release is now ${target_rel}."
}

cmd_releases() {
  local app_name="$2"
  local app_dir="${APPS_ROOT}/${app_name}"
  if [ ! -d "${app_dir}" ]; then
    log_error "Application '${app_name}' not found."
    exit 1
  fi

  local current_rel=""
  if [ -L "${app_dir}/current" ]; then
    current_rel=$(basename "$(readlink "${app_dir}/current")")
  fi

  echo "Stored releases for ${app_name}:"
  for rel_path in "${app_dir}/releases/"*; do
    local rel_name
    rel_name=$(basename "${rel_path}")
    if [ "${rel_name}" = "${current_rel}" ]; then
      echo "  * ${rel_name} (ACTIVE)"
    else
      echo "    ${rel_name}"
    fi
  done
}

main() {
  if [ $# -lt 1 ]; then
    usage
  fi

  local subcmd="$1"
  shift

  case "${subcmd}" in
    deploy) cmd_deploy "$@" ;;
    rollback) cmd_rollback "$@" ;;
    releases|status) cmd_releases "$@" ;;
    *) log_error "Unknown command '${subcmd}'"; usage ;;
  esac
}

main "$@"
