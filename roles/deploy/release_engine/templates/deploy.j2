#!/usr/bin/env bash
# ==============================================================================
# {{ release_engine_cli_path }}
# Generic Raw Application Release Deployment CLI
# ==============================================================================
# Ansible managed: Do NOT edit manually on host.

set -euo pipefail

APPS_ROOT="{{ release_engine_apps_root }}"

usage() {
cat <<EOF
  Usage: deploy <command> [options]

  Commands:
    deploy    Deploy a raw application release
    rollback  Rollback an application to a previous release
    status    Show active release status and deployment history
    releases  List all stored releases for an application

  Deploy Options:
    --name <app_name>           Application name
    --artifact <source>         Public HTTP(S) archive or executable URL
    --post-deploy <command>     Hook command to run after extraction
    --health <check>            Repeatable health check:
                                http://host/path
                                https://host/path
                                tcp://host:port
                                exec:"command"
    --keep-releases <num>       Number of releases to retain

  Rollback Options:
    --name <app_name>           Application name
    --steps <num>               Number of releases to rollback (default: 1)
EOF
exit 1
}

log_info() {
  echo "[INFO]  $(date +'%Y-%m-%d %H:%M:%S') - $*"
}

log_error() {
  echo "[ERROR] $(date +'%Y-%m-%d %H:%M:%S') - $*" >&2
}

log_warn() {
  echo "[WARN]  $(date +'%Y-%m-%d %H:%M:%S') - $*"
}

validate_app_name() {
  local name="$1"

  if ! [[ "${name}" =~ ^[A-Za-z0-9][A-Za-z0-9_-]*$ ]]; then
    log_error "Invalid --name '${name}'. Use only letters, numbers, '-' and '_', starting with a letter or number."
    exit 1
  fi
}

ensure_app_structure() {
  local app_name="$1"
  local app_dir="${APPS_ROOT}/${app_name}"

  mkdir -p \
    "${app_dir}/releases" \
    "${app_dir}/staging" \
    "${app_dir}/shared/logs" \
    "${app_dir}/shared/data"

  if [ ! -f "${app_dir}/shared/.env" ]; then
    touch "${app_dir}/shared/.env"
  fi

  if [ ! -f "${app_dir}/deploy.json" ]; then
    echo '{"active_release":"","history":[]}' > "${app_dir}/deploy.json"
  fi
}

run_health_check() {
  local checks=("$@")

  if [ "{% raw %}${#checks[@]}{% endraw %}" -eq 0 ]; then
    log_info "No health checks configured. Skipping health checks."
    return 0
  fi

  log_info "Running health checks..."

  for check in "${checks[@]}"; do
    case "${check}" in
      http://*|https://*)
        log_info "Polling HTTP endpoint: ${check}..."

        local retries=20
        local success=0

        for ((i=1; i<=retries; i++)); do
          local code

          code="$(
            curl \
              -s \
              -o /dev/null \
              -w "%{http_code}" \
              --max-time 5 \
              "${check}" ||
            echo "000"
          )"

          if [[ "${code}" =~ ^2[0-9]{2}$ ]]; then
            log_info "HTTP health check passed (HTTP ${code})."
            success=1
            break
          fi

          sleep 2
        done

        if [ "${success}" -eq 0 ]; then
          log_error "HTTP health check failed after ${retries} attempts: ${check}"
          return 1
        fi
        ;;

      tcp://*)
        local tcp_target="${check#tcp://}"
        local host="${tcp_target%%:*}"
        local port="${tcp_target##*:}"
        local retries=20
        local success=0

        log_info "Polling TCP socket: ${tcp_target}..."

        for ((i=1; i<=retries; i++)); do
          if nc -z -w 2 "${host}" "${port}" 2>/dev/null; then
            log_info "TCP health check passed for ${tcp_target}."
            success=1
            break
          fi

          sleep 2
        done

        if [ "${success}" -eq 0 ]; then
          log_error "TCP socket health check failed for ${tcp_target}."
          return 1
        fi
        ;;

      exec:*)
        local health_exec="${check#exec:}"

        log_info "Executing custom health check command: ${health_exec}..."

        if ! eval "${health_exec}"; then
          log_error "Custom health check command failed: ${health_exec}"
          return 1
        fi
        ;;

      *)
        log_error "Unsupported health check '${check}'."
        log_error "Use http://..., https://..., tcp://..., or exec:..."
        return 1
        ;;
    esac
  done

  log_info "All health checks passed successfully."
}

cmd_deploy() {
  local app_name=""
  local artifact=""
  local post_deploy=""
  local health_checks=()
  local keep_releases="{{ release_engine_default_keep_releases }}"

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --name)
        [ $# -ge 2 ] || {
          log_error "--name requires a value."
          usage
        }
        app_name="$2"
        shift 2
        ;;

      --artifact)
        [ $# -ge 2 ] || {
          log_error "--artifact requires a value."
          usage
        }
        artifact="$2"
        shift 2
        ;;

      --post-deploy)
        [ $# -ge 2 ] || {
          log_error "--post-deploy requires a value."
          usage
        }
        post_deploy="$2"
        shift 2
        ;;

      --health)
        [ $# -ge 2 ] || {
          log_error "--health requires a value."
          usage
        }
        health_checks+=("$2")
        shift 2
        ;;

      --keep-releases)
        [ $# -ge 2 ] || {
          log_error "--keep-releases requires a value."
          usage
        }
        keep_releases="$2"
        shift 2
        ;;

      *)
        log_error "Unknown option: $1"
        usage
        ;;
    esac
  done

  if [ -z "${app_name}" ] || [ -z "${artifact}" ]; then
    log_error "--name and --artifact are required."
    usage
  fi

  validate_app_name "${app_name}"

  if [[ "${artifact}" != http://* && "${artifact}" != https://* ]]; then
    log_error "Raw artifacts must use a public HTTP(S) URL via --artifact."
    exit 1
  fi

  if ! [[ "${keep_releases}" =~ ^[1-9][0-9]*$ ]]; then
    log_error "--keep-releases must be a positive integer."
    exit 1
  fi

  local app_dir="${APPS_ROOT}/${app_name}"

  ensure_app_structure "${app_name}"

  local release_id
  release_id="$(date +'%Y%m%d%H%M%S')"

  local target_release_dir="${app_dir}/releases/${release_id}"
  local staging_dir="${app_dir}/staging/${release_id}"
  local archive_path="${staging_dir}/artifact"

  mkdir -p "${staging_dir}"

  log_info "Starting deployment for '${app_name}' (Release: ${release_id})..."
  log_info "Downloading raw artifact from ${artifact}..."

  if ! curl -fsSL "${artifact}" -o "${archive_path}"; then
    log_error "Download failed."
    rm -rf "${staging_dir}"
    exit 1
  fi

  mkdir -p "${target_release_dir}"

  log_info "Extracting artifact to release directory..."

  if tar -tf "${archive_path}" &>/dev/null; then
    tar -xf "${archive_path}" -C "${target_release_dir}"
  elif unzip -t "${archive_path}" &>/dev/null; then
    unzip -q "${archive_path}" -d "${target_release_dir}"
  else
    mv "${archive_path}" "${target_release_dir}/executable"
    chmod +x "${target_release_dir}/executable"
  fi

  rm -rf "${staging_dir}"

  ln -sf "${app_dir}/shared/.env" "${target_release_dir}/.env"
  ln -sf "${app_dir}/shared/data" "${target_release_dir}/data"
  ln -sf "${app_dir}/shared/logs" "${target_release_dir}/logs"

  if [ -n "${post_deploy}" ]; then
    log_info "Running post-deploy hook..."

    (
      cd "${target_release_dir}"
      eval "${post_deploy}"
    )
  fi

  local prev_release=""

  if [ -L "${app_dir}/current" ]; then
    prev_release="$(basename "$(readlink "${app_dir}/current")")"
  fi

  log_info "Switching ${app_dir}/current -> ${release_id}..."

  ln -sfn "releases/${release_id}" "${app_dir}/current"

  if ! run_health_check "${health_checks[@]}"; then
    log_error "Health check failed! Initiating automatic rollback..."

    if [ -n "${prev_release}" ] &&
       [ -d "${app_dir}/releases/${prev_release}" ]; then
      ln -sfn "releases/${prev_release}" "${app_dir}/current"
      log_warn "Rolled back atomically to release ${prev_release}."
    else
      log_error "No previous release found to roll back to!"
    fi

    exit 1
  fi

  log_info "Updating deploy.json history..."

  local updated_json

  updated_json="$(
    jq \
      --arg rel "${release_id}" \
      '.active_release = $rel | .history += [$rel]' \
      "${app_dir}/deploy.json"
  )"

  echo "${updated_json}" > "${app_dir}/deploy.json"

  log_info "Applying release retention policy (keeping latest ${keep_releases} releases)..."

  mapfile -t releases < <(
    find "${app_dir}/releases" \
      -mindepth 1 \
      -maxdepth 1 \
      -type d \
      -printf '%f\n' |
    sort
  )

  local release_count="{% raw %}${#releases[@]}{% endraw %}"
  local keep_start=$((release_count - keep_releases))

  if [ "${keep_start}" -gt 0 ]; then
    for ((i=0; i<keep_start; i++)); do
      local old_release="${releases[$i]}"

      if [ "${old_release}" = "${release_id}" ] ||
         [ "${old_release}" = "${prev_release}" ]; then
        continue
      fi

      log_info "Pruning old release: ${old_release}"
      rm -rf "${app_dir}/releases/${old_release}"
    done
  fi

  log_info "Deployment completed successfully for ${app_name} (Release: ${release_id})."
}

cmd_rollback() {
  local app_name=""
  local steps=1

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --name)
        [ $# -ge 2 ] || {
          log_error "--name requires a value."
          usage
        }
        app_name="$2"
        shift 2
        ;;

      --steps)
        [ $# -ge 2 ] || {
          log_error "--steps requires a value."
          usage
        }
        steps="$2"
        shift 2
        ;;

      *)
        log_error "Unknown option: $1"
        usage
        ;;
    esac
  done

  if [ -z "${app_name}" ]; then
    log_error "--name is required for rollback."
    usage
  fi

  validate_app_name "${app_name}"

  if ! [[ "${steps}" =~ ^[1-9][0-9]*$ ]]; then
    log_error "--steps must be a positive integer."
    exit 1
  fi

  local app_dir="${APPS_ROOT}/${app_name}"

  if [ ! -d "${app_dir}" ] || [ ! -L "${app_dir}/current" ]; then
    log_error "Application '${app_name}' does not exist or has no active deployment."
    exit 1
  fi

  local current_rel
  current_rel="$(basename "$(readlink "${app_dir}/current")")"

  mapfile -t releases < <(
    find "${app_dir}/releases" \
      -mindepth 1 \
      -maxdepth 1 \
      -type d \
      -printf '%f\n' |
    sort
  )

  local total="{% raw %}${#releases[@]}{% endraw %}"
  local curr_index=-1

  for ((i=0; i<total; i++)); do
    if [ "${releases[$i]}" = "${current_rel}" ]; then
      curr_index="${i}"
      break
    fi
  done

  if [ "${curr_index}" -lt 0 ]; then
    log_error "Active release '${current_rel}' was not found."
    exit 1
  fi

  local target_index=$((curr_index - steps))

  if [ "${target_index}" -lt 0 ]; then
    log_error "Cannot rollback ${steps} step(s). Not enough historical releases stored."
    exit 1
  fi

  local target_rel="${releases[$target_index]}"

  log_info "Rolling back '${app_name}' from release ${current_rel} -> ${target_rel}..."

  ln -sfn "releases/${target_rel}" "${app_dir}/current"

  local updated_json

  updated_json="$(
    jq \
      --arg rel "${target_rel}" \
      '.active_release = $rel' \
      "${app_dir}/deploy.json"
  )"

  echo "${updated_json}" > "${app_dir}/deploy.json"

  log_info "Rollback successful. '${app_name}' active release is now ${target_rel}."
}

cmd_releases() {
  local app_name=""

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --name)
        [ $# -ge 2 ] || {
          log_error "--name requires a value."
          usage
        }
        app_name="$2"
        shift 2
        ;;

      *)
        log_error "Unknown option: $1"
        usage
        ;;
    esac
  done

  if [ -z "${app_name}" ]; then
    log_error "--name is required."
    usage
  fi

  validate_app_name "${app_name}"

  local app_dir="${APPS_ROOT}/${app_name}"

  if [ ! -d "${app_dir}" ]; then
    log_error "Application '${app_name}' not found."
    exit 1
  fi

  local current_rel=""

  if [ -L "${app_dir}/current" ]; then
    current_rel="$(basename "$(readlink "${app_dir}/current")")"
  fi

  echo "Stored releases for ${app_name}:"

  mapfile -t releases < <(
    find "${app_dir}/releases" \
      -mindepth 1 \
      -maxdepth 1 \
      -type d \
      -printf '%f\n' |
    sort
  )

  for rel_name in "${releases[@]}"; do
    if [ "${rel_name}" = "${current_rel}" ]; then
      echo "  * ${rel_name} (ACTIVE)"
    else
      echo "    ${rel_name}"
    fi
  done
}

cmd_status() {
  local app_name=""

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --name)
        [ $# -ge 2 ] || {
          log_error "--name requires a value."
          usage
        }
        app_name="$2"
        shift 2
        ;;

      *)
        log_error "Unknown option: $1"
        usage
        ;;
    esac
  done

  if [ -z "${app_name}" ]; then
    log_error "--name is required."
    usage
  fi

  validate_app_name "${app_name}"

  local app_dir="${APPS_ROOT}/${app_name}"

  if [ ! -d "${app_dir}" ]; then
    log_error "Application '${app_name}' not found."
    exit 1
  fi

  echo "Application: ${app_name}"

  if [ -L "${app_dir}/current" ]; then
    echo "Active release: $(basename "$(readlink "${app_dir}/current")")"
  else
    echo "Active release: none"
  fi

  echo
  echo "Deployment history:"

  jq -r '.history[]?' "${app_dir}/deploy.json"
}

main() {
  if [ $# -lt 1 ]; then
    usage
  fi

  local subcmd="$1"
  shift

  case "${subcmd}" in
    deploy)
      cmd_deploy "$@"
      ;;
    rollback)
      cmd_rollback "$@"
      ;;
    releases)
      cmd_releases "$@"
      ;;
    status)
      cmd_status "$@"
      ;;
    *)
      log_error "Unknown command '${subcmd}'."
      usage
      ;;
  esac
}

main "$@"
