#!/usr/bin/env bash
# ==============================================================================
# {{ deployproxy_cli_path }}
# Dedicated Proxy Artifact Deployment CLI
# ==============================================================================
# Ansible managed: Do NOT edit manually on host.
#
# Downloads a raw proxy configuration artifact, optionally validates it,
# and deploys it into the configured proxy drop-in directory.
#
# The deployment mechanism is proxy-backend agnostic.
# Runtime-specific validation can be supplied with:
#   - --validator-check
#   - --validator-command
#
# Examples:
#   Caddy:
#     caddy validate --config %s --adapter caddyfile
#
#   Nginx:
#     nginx -t -c %s

set -euo pipefail

show_usage() {
  cat <<EOF
    Usage: {{ deployproxy_command }} --name <app_name> --artifact <https://...> --proxy-ext <ext> [options]

    Required options:
      --name <app_name>            Application name, e.g. webapp
      --artifact <source>          HTTP(S) URL to the raw proxy configuration
      --proxy-ext <ext>            Config extension to write, e.g. caddyfile or conf

    Optional options:
      --validator-check <cmd>      Runtime presence check
                                  e.g. "command -v caddy"
                                  or "command -v nginx"

      --validator-command <cmd>    Validation command using %s as the
                                  downloaded temporary file

    Example (Caddy):
      {{ deployproxy_command }} \
        --name webapp \
        --artifact "https://github.com/org/repo/releases/download/proxy-v1.2.3/webapp.caddyfile" \
        --proxy-ext caddyfile \
        --validator-check "command -v caddy" \
        --validator-command "caddy validate --config %s --adapter caddyfile"

    Example (Nginx):
      {{ deployproxy_command }} \
        --name webapp \
        --artifact "https://github.com/org/repo/releases/download/proxy-v1.2.3/webapp.conf" \
        --proxy-ext conf \
        --validator-check "command -v nginx" \
        --validator-command "nginx -t -c %s"
EOF
}

usage() {
  show_usage
  exit 1
}

usage_exit0() {
  show_usage
  exit 0
}

log_info() {
  echo "[INFO]  $(date +'%Y-%m-%d %H:%M:%S') - $*"
}

log_error() {
  echo "[ERROR] $(date +'%Y-%m-%d %H:%M:%S') - $*" >&2
}

require_value() {
  local arg_name="$1"
  local value="${2:-}"

  if [[ -z "${value}" ]]; then
    log_error "Missing value for ${arg_name}."
    usage
  fi
}

app_name=""
artifact=""
proxy_ext=""
validator_check=""
validator_command=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help)
      usage_exit0
      ;;

    --name)
      require_value "--name" "${2:-}"
      app_name="$2"
      shift 2
      ;;

    --artifact)
      require_value "--artifact" "${2:-}"
      artifact="$2"
      shift 2
      ;;

    --proxy-ext)
      require_value "--proxy-ext" "${2:-}"
      proxy_ext="$2"
      shift 2
      ;;

    --validator-check)
      require_value "--validator-check" "${2:-}"
      validator_check="$2"
      shift 2
      ;;

    --validator-command)
      require_value "--validator-command" "${2:-}"
      validator_command="$2"
      shift 2
      ;;

    *)
      log_error "Unknown option: $1"
      usage
      ;;
  esac
done

if [[ -z "${app_name}" || -z "${artifact}" || -z "${proxy_ext}" ]]; then
  log_error "--name, --artifact and --proxy-ext are required."
  usage
fi

if [[ "${artifact}" != http://* && "${artifact}" != https://* ]]; then
  log_error "Proxy artifacts must use an HTTP(S) URL via --artifact."
  exit 1
fi

target_file="${deployproxy_dropin_dir}/${app_name}.${proxy_ext}"
temp_file=$(mktemp /tmp/proxy.XXXXXX)

cleanup() {
  rm -f "${temp_file}"
}

trap cleanup EXIT

log_info "Downloading proxy config artifact for '${app_name}'..."

if ! curl -fsSL "${artifact}" -o "${temp_file}"; then
  log_error "Failed to download proxy config from ${artifact}"
  exit 1
fi

if [[ -n "${validator_check}" ]]; then
  log_info "Checking whether the proxy backend is available..."

  if ! bash -lc "${validator_check}" >/dev/null 2>&1; then
    log_error "Proxy validation dependency check failed: ${validator_check}"
    exit 1
  fi
fi

if [[ -n "${validator_command}" ]]; then
  log_info "Validating proxy config syntax..."

  validator_cmd="${validator_command//%s/${temp_file}}"

  if ! bash -lc "${validator_cmd}" >/dev/null 2>&1; then
    log_error "Downloaded proxy config contains syntax errors! Deployment aborted."
    exit 1
  fi
fi

log_info "Deploying drop-in configuration to ${target_file}..."

mv "${temp_file}" "${target_file}"
chmod 0664 "${target_file}"

log_info "Proxy deployment completed successfully for '${app_name}'."
